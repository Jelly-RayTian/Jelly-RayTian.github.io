---
import { nav, route, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const other: Lang = lang === 'en' ? 'zh' : 'en';
const isActive = (n: (typeof nav)[number]) => ('exact' in n ? path === n.path : n.match.some((p) => path.startsWith(p)));
const zh = lang === 'zh';
---
<header class="nav">
  <div class="wrap">
    <a class="mark" href={route(lang, '/')} aria-label={t(lang, 'home')}>
      <i aria-hidden="true">R</i>
      <span><b>Ray Tian</b><small>{zh ? '滑铁卢大学 · 数学 Co-op' : 'Waterloo · Math Co-op'}</small></span>
    </a>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={route(lang, n.path)} aria-current={isActive(n) ? 'page' : undefined}>{t(lang, n.key)}</a></li>
        ))}
      </ul>
    </nav>
    <div class="act">
      <a class="icon-btn" href={route(other, path)} hreflang={other === 'zh' ? 'zh-CN' : 'en'} lang={other === 'zh' ? 'zh-CN' : 'en'} aria-label={t(lang, 'langSwitchLabel')}>{t(lang, 'langSwitch')}</a>
      <button class="icon-btn" id="theme" type="button" aria-label={t(lang, 'themeLabel')}>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
      <a class="btn sm primary cta-contact" href={route(lang, '/about/#contact')}>{zh ? '联系我' : 'Contact'}</a>
      <button class="icon-btn menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t(lang, 'menu')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
