---
import { nav, route, t, type Lang } from '../i18n/ui';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const other: Lang = lang === 'en' ? 'zh' : 'en';
const isActive = (match: readonly string[]) => match.some((p) => path.startsWith(p));
---
<header class="nav">
  <div class="wrap">
    <a class="mark" href={route(lang, '/')} aria-label={t(lang, 'home')}>Ray <b>Tian</b></a>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={route(lang, n.path)} aria-current={isActive(n.match) ? 'page' : undefined}>{t(lang, n.key)}</a></li>
        ))}
      </ul>
    </nav>
    <div class="act">
      <a class="pill" href={route(other, path)} hreflang={other === 'zh' ? 'zh-CN' : 'en'} lang={other === 'zh' ? 'zh-CN' : 'en'} aria-label={t(lang, 'langSwitchLabel')}>{t(lang, 'langSwitch')}</a>
      <button class="pill" id="theme" type="button" aria-label={t(lang, 'themeLabel')} data-light={t(lang, 'themeLight')} data-dark={t(lang, 'themeDark')}>{t(lang, 'themeLight')}</button>
      <button class="pill menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">{t(lang, 'menu')}</button>
    </div>
  </div>
</header>
