---
import BaseLayout from '../layouts/BaseLayout.astro';
import { route, t } from '../i18n/ui';
---
<BaseLayout lang="en" path="/" title={t('en', 'notFound')} description={t('en', 'notFoundText')} noindex>
  <div class="page-top"><div class="wrap">
    <span class="eyebrow">404</span><h1>{t('en', 'notFound')}</h1><p class="lead">{t('en', 'notFoundText')}</p>
    <div class="btns" style="margin:24px 0 80px"><a class="btn primary" href={route('en', '/')}>Home</a><a class="btn" href={route('zh', '/')}>首页</a></div>
  </div></div>
</BaseLayout>
