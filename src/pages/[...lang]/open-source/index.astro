---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import SubNav from '../../../components/SubNav.astro';
import PrWall from '../../../components/PrWall.astro';
import PrExplorer from '../../../components/PrExplorer.astro';
import CaseStudies from '../../../components/CaseStudies.astro';
import { localePaths } from '../../../lib/paths';
import { pages, home } from '../../../content/data/pages';
import { repos, repoStats, prs, count, statusName } from '../../../lib/data';
import { t, type Lang } from '../../../i18n/ui';
export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const pg = pages[lang].openSource;
const hdr = lang === 'zh'
  ? ['仓库', 'PR', '已合并', 'squash', '整合', '审核中/草稿']
  : ['Repository', 'PRs', 'Merged', 'Squashed', 'Consolidated', 'Open/draft'];
const recent = [
  {
    repo: 'dongdongbh/Mindwtr', number: 1610,
    en: 'Adds a native macOS Settings menu item and ⌘, shortcut that reuse the app’s existing navigation. The maintainer requested documentation and native macOS testing on Nov 24.',
    zh: '添加 macOS 原生「设置」菜单和 ⌘, 快捷键，复用现有的设置页导航。维护者于 11 月 24 日要求补充文档并在 macOS 上实测。',
  },
  {
    repo: 'PDFCraftTool/pdfcraft', number: 367,
    en: 'Keeps preset stamp labels inside the border when rotated. Verified label positions in the saved PDF at 0°, 90°, and −90°.',
    zh: '修复预设印章旋转后文字偏出边框的问题，并核对了导出 PDF 在 0°、90° 和 −90° 时的文字位置。',
  },
  {
    repo: 'PDFCraftTool/pdfcraft', number: 366,
    en: 'Centers the rotated spine title on printable book covers. Checked the output with a separate PDF renderer.',
    zh: '让打印封面的旋转书脊标题居中，并用独立 PDF 渲染器核对输出。',
  },
  {
    repo: 'PDFCraftTool/pdfcraft', number: 365,
    en: 'Keeps previously cropped margins hidden when resizing PDFs. Verified fit and fill across all four right-angle rotations.',
    zh: '统一页面尺寸时保留原有裁切范围。验证了四种直角旋转下的适应和填充模式。',
  },
  {
    repo: 'PDFCraftTool/pdfcraft', number: 360,
    en: 'Removes stale widget references after flattening a form while preserving valid annotations.',
    zh: '在表单扁平化后清除失效的控件引用，同时保留正常批注。',
  },
].flatMap(({ repo, number, ...description }) => {
  const pr = prs.find((item) => item.repo === repo && item.number === number);
  return pr ? [{ pr, description: description[lang] }] : [];
});

const nav = lang === 'zh'
  ? [{ id: 'overview', label: '总览' }, { id: 'recent', label: '近期贡献' }, { id: 'cases', label: '案例研究' }, { id: 'all-prs', label: '全部 pull request' }]
  : [{ id: 'overview', label: 'Overview' }, { id: 'recent', label: 'Recent contributions' }, { id: 'cases', label: 'Case studies' }, { id: 'all-prs', label: 'Every pull request' }];
---
<BaseLayout lang={lang} path="/open-source/" title={pg.k} description={pg.p}>
  <PageHead k={pg.k} h={pg.h} p={pg.p} />
  <SubNav items={nav} label={pg.k} />
  <div class="wrap page-body">
    <section class="sec" id="overview">
      <PrWall lang={lang} headline={home[lang].wallTitle} />
      <div class="tablewrap">
        <table class="rtable">
          <thead><tr>{hdr.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>
            {repos.map((r) => { const s = repoStats(r); return <tr><th scope="row"><a href={`https://github.com/${r}`}>{r}</a></th><td>{s.total}</td><td>{s.merged}</td><td>{s.squashed}</td><td>{s.consolidated}</td><td>{s.open}</td></tr>; })}
            <tr class="total"><th scope="row">{lang === 'zh' ? '外部合计' : 'External total'}</th><td>{prs.length}</td><td>{count('merged')}</td><td>{count('squashed')}</td><td>{count('consolidated')}</td><td>{count('open') + count('draft')}</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="sec" id="recent">
      <div class="sec-h"><h2>{nav[1].label}</h2></div>
      <ul class="recent">
        {recent.map(({ pr, description }) => (
          <li>
            <div><a href={pr.url}>{pr.repo} #{pr.number}</a><span class="st">{statusName(pr.status, lang)}</span></div>
            <p>{description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="sec" id="cases">
      <div class="sec-h"><h2>{nav[2].label}</h2></div>
      <p class="sec-intro">{lang === 'zh' ? '左侧是我的 PR 里的结果；右侧是维护者随后做了什么。' : 'Left: the results from my PR. Right: what the maintainers did with it.'}</p>
      <CaseStudies lang={lang} />
    </section>

    <section class="sec" id="all-prs">
      <div class="sec-h"><h2>{nav[3].label}</h2><a class="arrow-link" href="https://github.com/Jelly-RayTian/Jelly-RayTian/blob/main/OPEN_SOURCE_CONTRIBUTIONS.md">{t(lang, 'ledger')} ↗</a></div>
      <PrExplorer lang={lang} />
    </section>
  </div>
</BaseLayout>

