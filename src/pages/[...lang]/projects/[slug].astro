---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import ProjectVisual from '../../../components/ProjectVisual.astro';
import { route, t, type Lang } from '../../../i18n/ui';
export async function getStaticPaths() {
  const all = await getCollection('projects');
  return all.map((entry) => ({
    params: { lang: entry.data.lang === 'zh' ? 'zh' : undefined, slug: entry.data.pageSlug },
    props: { entry, lang: entry.data.lang as Lang },
  }));
}
const { entry, lang } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<BaseLayout lang={lang} path={`/projects/${d.pageSlug}/`} title={d.title} description={d.summary} ogImage={d.image ?? '/assets/watdesk.jpg'} type="article">
  <div class="wrap narrow">
    <p class="crumb"><a href={route(lang, '/projects/')}>← {t(lang, 'backTo')} {t(lang, 'projects')}</a></p>
    <header class="detail-head">
      {d.period && <span class="eyebrow">{d.period}</span>}
      <h1>{d.title}</h1>
      <p>{d.summary}</p>
      {d.stack && <div class="tags">{d.stack.split(/\s*·\s*/).map((x) => <span class="tag">{x}</span>)}</div>}
    </header>
    {d.status && <p class="statusline"><span class="dot" aria-hidden="true"></span><span>{d.status}</span></p>}
    {d.links.length > 0 && (
      <div class="btns" style="margin:18px 0 4px">{d.links.map((l, i) => <a class={i === 0 ? 'btn primary' : 'btn'} href={l.url}>{l.label} ↗</a>)}</div>
    )}
    {d.image && (
      <figure class="shot">
        <img class={d.imageDark && d.imageDark !== d.image ? 'l' : ''} src={d.image} alt={d.title} width="800" height="500" />
        {d.imageDark && d.imageDark !== d.image && <img class="d" src={d.imageDark} alt={d.title} width="800" height="500" />}
      </figure>
    )}
    {!d.image && d.flow && <ProjectVisual p={entry} />}
    <div class="prose"><Content /></div>
  </div>
</BaseLayout>
