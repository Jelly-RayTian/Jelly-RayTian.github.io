---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { route, t, type Lang } from '../../../i18n/ui';
export async function getStaticPaths() {
  const all = await getCollection('systems');
  return all.map((entry) => ({
    params: { lang: entry.data.lang === 'zh' ? 'zh' : undefined, slug: entry.data.pageSlug },
    props: { entry, lang: entry.data.lang as Lang },
  }));
}
const { entry, lang } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<BaseLayout lang={lang} path={`/systems/${d.pageSlug}/`} title={d.title} description={d.summary} type="article">
  <section class="block"><div class="wrap narrow">
    <p class="crumb"><a href={route(lang, '/systems/')}>← {t(lang, 'backTo')} {t(lang, 'systems')}</a></p>
    <article class="article">
      <header class="sh page-head">
        <span class="kicker">{d.subtitle}</span>
        <h1 class="page-h">{d.title}</h1>
        <p>{d.summary}</p>
        {d.updated && <p class="updated">{t(lang, 'lastUpdated')}: <time datetime={d.updated}>{d.updated}</time></p>}
      </header>
      {d.glance.length > 0 && (
        <aside class="glance" aria-label={t(lang, 'atAGlance')}>
          <h2>{t(lang, 'atAGlance')}</h2>
          <dl>{d.glance.map((g) => <div><dt>{g.k}</dt><dd>{g.v}</dd></div>)}</dl>
        </aside>
      )}
      {toc.length > 2 && (
        <nav class="toc" aria-label={t(lang, 'onThisPage')}>
          <h2>{t(lang, 'onThisPage')}</h2>
          <ol>{toc.map((h) => <li class={h.depth === 3 ? 'sub' : ''}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <div class="prose"><Content /></div>
      {d.references.length > 0 && (
        <section class="refs" aria-label={t(lang, 'references')}>
          <ul>{d.references.map((r) => <li><a href={r.url} rel="noopener">{r.label}</a></li>)}</ul>
        </section>
      )}
    </article>
  </div></section>
</BaseLayout>
