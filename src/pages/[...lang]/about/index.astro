---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import { localePaths } from '../../../lib/paths';
import { pages } from '../../../content/data/pages';
import { content } from '../../../lib/data';
import { t, type Lang } from '../../../i18n/ui';
export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const pg = pages[lang].about;
---
<BaseLayout lang={lang} path="/about/" title={pg.k} description={content.about[lang].slice(0, 180)}>
  <section class="block"><div class="wrap">
    <PageHead k={pg.k} h={pg.h} p={pg.p} />
    <div class="about-grid">
      <p class="about-text">{content.about[lang]}</p>
      <div>
        <h2 class="mini-h">{t(lang, 'interests')}</h2>
        <ul class="chips">{content.interests.map((i) => <li>{i[lang]}</li>)}</ul>
      </div>
    </div>
    <div class="skills-panel xcard">
      <h2>{t(lang, 'skills')}</h2>
      <dl>
        {content.skills.map((s) => <div><dt>{s.label[lang]}</dt><dd>{s.items[lang]}</dd></div>)}
        <div><dt>{t(lang, 'languagesLabel')}</dt><dd>{content.languages[lang]}</dd></div>
      </dl>
    </div>
  </div></section>
</BaseLayout>
