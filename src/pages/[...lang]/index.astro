---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localePaths } from '../../lib/paths';
import { home } from '../../content/data/pages';
import { content, entry, prs, repos, repoStats } from '../../lib/data';
import { route, t, type Lang } from '../../i18n/ui';
import Entry from '../../components/Entry.astro';
export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const zh = lang === 'zh';
const h = home[lang];
const L = (en: string, cn: string) => (zh ? cn : en);
const systems = (await getCollection('systems')).filter((s) => s.data.lang === lang);
const pvz = systems.find((e) => e.data.pageSlug === 'pvz2-resource-analysis')!;
const uw = content.education[0][lang];
const hs = content.education[1][lang];
const teamRepos = ['CommunihacksSeed/Seedtrack', 'CommunihacksSeed/exodus'];
const ossRepos = repos.filter((r) => !teamRepos.includes(r)).sort((a, b) => repoStats(b).total - repoStats(a).total);
const merged = prs.filter((p) => p.status === 'merged' && !teamRepos.includes(p.repo)).length;
const mergedRepos = ossRepos.filter((r) => repoStats(r).merged > 0).length;
const proj = (slug: string) => route(lang, `/projects/${slug}/`);
const recentProjectSlugs = ['pixel-buddies', 'velzora', 'ctxport'];
const recentProjects = (await getCollection('projects'))
  .map((entry) => entry.data)
  .filter((project) => project.lang === lang && recentProjectSlugs.includes(project.pageSlug))
  .sort((a, b) => a.order - b.order)
  .map((project) => ({
    name: project.title,
    desc: project.stack,
    date: project.period,
    href: proj(project.pageSlug),
    bullets: [project.summary, project.status].filter((x): x is string => Boolean(x)),
  }));
const projects = [
  ...recentProjects,
  { name: 'WatDesk', desc: L('independent Edge extension for Waterloo students (TypeScript, React)', '面向滑铁卢学生的独立 Edge 扩展（TypeScript、React）'), date: L('Oct 2026 – present', '2026 年 10 月至今'), href: proj('watdesk'),
    bullets: [
      L('Deadlines, exams and grades are scattered across LEARN, Crowdmark and Odyssey; I built one bilingual (English / Simplified Chinese) side panel with a timeline, workload view, exam countdowns, calendar export and an optional course-outline source.', 'LEARN、Crowdmark 和 Odyssey 里的截止日期、考试和成绩很分散；我做了一个中英双语侧边栏，含时间线、工作量视图、考试倒计时、日历导出和可选的课程大纲来源。'),
      L('Data stays in the user\'s browser and passwords are never read. Listed on Microsoft Edge Add-ons; 9 releases (latest v1.10.1); 290 automated tests passed at v1.10.1. Built with AI coding assistance: I scoped the features and reviewed the changes.', '数据留在用户浏览器里，从不读取密码。已在 Microsoft Edge 加载项商店上架；共 9 个版本（最新 v1.10.1）；v1.10.1 时 290 个自动化测试通过。借助 AI 编程助手完成：我负责界定功能并审查改动。'),
    ] },
  { name: L('PvZ2 resource-file research and article', 'PvZ2 资源文件研究与文章'), desc: L('self-directed study', '自主研究'), date: L('Nov 2026', '2026 年 11 月'), href: route(lang, `/systems/${pvz.data.pageSlug}/`),
    bullets: [L('Studied how a mobile game\'s resource files are layered (RSB, RTON), wrote a small decoder (14 passing tests on synthetic data), and published the explanation on DEV Community (English) and Zhihu (Chinese).', '研究了一款手游资源文件的分层方式（RSB、RTON），写了一个小解码器（合成数据上 14 个测试通过），并把讲解发表在 DEV Community（英文）和知乎（中文）。')] },
  { name: 'Exodus (Clear Council)', desc: L('CIVIC Hack 2026 team project · winner, Best storytelling and visualizations', 'CIVIC Hack 2026 团队项目 · 获奖：最佳叙事与可视化'), date: L('Nov 2026', '2026 年 11 月'), href: 'https://devpost.com/software/exodus-czjiq5',
    bullets: [
      L('Turns a City of Toronto council agenda item into one plain-language page, every sentence linked to the exact passage in the official record; the build refuses to publish a quote it cannot find. Four-person team.', '把多伦多市议会的一份议程事项变成一个通俗语言页面，每句话都链接到官方记录中的原文；找不到引用原文时，构建拒绝发布。团队四人。'),
      L('I directed and merged AI-assisted pull requests (11 merged so far): security hardening, a 3D decision map, a multilingual interface, a drive mode and a human review sign-off of all 15 explanations. The project\'s Devpost page discloses its AI use.', '我指导并合并了借助 AI 完成的 pull request（目前已合并 11 个）：安全加固、3D 决策地图、多语言界面、驾驶模式，以及对全部 15 条解释的人工复核签字。项目的 Devpost 页面披露了 AI 的使用。'),
    ] },
  { name: 'WechatSignals', desc: L('local-first macOS tool for analysing one-to-one chats (TypeScript, Swift)', '本地优先的 macOS 单聊分析工具（TypeScript、Swift）'), date: L('Oct 2026', '2026 年 10 月'), href: proj('wechatsignals'),
    bullets: [L('Designed around privacy: read-only access, anonymised participants, API key in Keychain, data sent only when the user clicks. Beta release v0.1.0-beta.1.', '以隐私为设计前提：只读访问、参与者匿名化、API key 存在 Keychain、只有用户点击才发送数据。Beta 版本 v0.1.0-beta.1。')] },
];
const leadership = [
  { name: L('Peer Listening Group', '同伴倾听小组'), role: L('Founder & Organizer', '发起人与组织者'), date: L('High school', '高中'), text: L('Founded and ran a weekly group; membership grew from 8 to 22 in one semester, with guidance arranged from a school counsellor.', '发起并组织每周一次的小组；一个学期内成员从 8 人增长到 22 人，并协调学校辅导老师提供指导。') },
  { name: L('Community Grocery Coordination', '社区采购协调'), role: L('Volunteer', '志愿者'), date: '2021', text: L('Collected grocery needs from neighbourhood families and helped coordinate supplies and donations; assisted about 25 households over roughly two months.', '收集邻里家庭的采购需求，协助协调物资和捐赠；约两个月内帮助了大约 25 户家庭。') },
  { name: L('Peer Learning Support', '同伴学习互助'), role: L('Organizer & Volunteer Tutor', '组织者与志愿辅导'), date: L('2021 – high school', '2021 – 高中'), text: L('Organized a peer homework-help group (5 to 8 members) and tutored a classmate in English for four consecutive months.', '组织 5 到 8 人的作业互助小组，并连续四个月为一位同学辅导英语。') },
  { name: L('Class roles', '班级职务'), role: L('Academic committee member, 3 years; History representative', '学习委员，三年；历史课代表'), date: L('High school · middle school', '高中 · 初中'), text: L('Organized study groups and helped classmates; collected homework and assisted the teacher.', '组织学习小组、帮助同学；收作业并协助老师。') },
];
const ossDesc: Record<string, { name: string; d: string; b: string }> = {
  'PDFCraftTool/pdfcraft': { name: 'PDFCraft', d: L('browser PDF toolkit', '浏览器端 PDF 工具箱'), b: L('Fixed PDF rotation dropping forms, bookmarks and links (11 regression cases failed before the fix) and Unicode page labels saved as garbled text.', '修复 PDF 旋转时丢失表单、书签和链接的问题（修复前 11 个回归用例失败），以及 Unicode 页码标签被存成乱码。') },
  'willfaust/Madeira': { name: 'Madeira', d: L('Windows-on-iOS compatibility layer', 'iOS 上运行 Windows 的兼容层'), b: L('Fixed a startup memory overwrite for long working directories (12 of 24 test cases failed before, all 24 pass; squashed onto main by the maintainer) and two further fixes now on main.', '修复过长工作目录导致的启动内存覆盖（修复前 24 个用例中 12 个失败，现全部通过；维护者 squash 进了 main），另有两项修复已在 main 上。') },
  'Leviidev/Henge': { name: 'Henge', d: L('emulate macOS on iOS and iPadOS', '在 iOS 和 iPadOS 上模拟 macOS'), b: L('Fixed a tool truncating its input file when source and destination were the same file, hard link or symlink, and a second tap on Install starting a duplicate install. Both merged.', '修复工具在源文件和目标文件相同（含硬链接、符号链接）时截断输入文件的问题，以及重复点击“安装”会启动第二次安装的问题。两项均已合并。') },
  'sherlock-project/sherlock': { name: 'Sherlock', d: L('username search across social networks (Python)', '跨社交网络查找用户名（Python）'), b: L('Proposed using Chess.com\'s public API for the Chess profile check, tested with known and random usernames. The pull request is open.', '提议用 Chess.com 的公开 API 来检测 Chess 账号，并用已知和随机用户名测试过。该 PR 审核中。') },
  'DaKheera47/job-ops': { name: 'job-ops', d: L('self-hosted job-search tool', '自托管求职工具'), b: L('Fixed posting dates shifting by a day across time zones and daylight saving, checked under four time zones; added client-side PDF import.', '修复发布日期在时区和夏令时下偏移一天的问题，并在四个时区下验证；新增客户端 PDF 导入。') },
};
const facts = [
  { v: '83/100', l: L('Euclid Mathematics Contest 2025', 'Euclid 数学竞赛 2025') },
  { v: '290', l: L('automated tests passing in WatDesk v1.10.1', 'WatDesk v1.10.1 通过的自动化测试') },
  { v: String(merged), l: L(`pull requests merged in ${mergedRepos} open-source projects`, `个 PR 已合并，涉及 ${mergedRepos} 个开源项目`) },
  { v: L('Winner', '获奖'), l: L('CIVIC Hack 2026 · Best storytelling and visualizations', 'CIVIC Hack 2026 · 最佳叙事与可视化') },
];
const bar = (r: string) => { const st = repoStats(r); const t = st.total || 1; const inMain = st.squashed + st.consolidated; return [
  ['merged', st.merged], ['main', inMain], ['open', st.open], ].map(([k, n]) => ({ k: String(k), w: (Number(n) / t) * 100 })).filter((x) => x.w > 0); };
const research = ['housing-advocacy', 'ai-economics'].map((id) => entry(id)[lang]);
const competitions = [
  { name: 'CIVIC Hack 2026', badge: L('Winner', '获奖'), desc: L('Best storytelling and visualizations, with the team project Exodus (Clear Council): one of 6 winning teams among 27 submissions on Devpost. Online hackathon run by the Future Cities Institute, University of Waterloo.', '以团队项目 Exodus（Clear Council）获得 Best storytelling and visualizations（最佳叙事与可视化）：Devpost 上 27 个提交中的 6 个获奖项目之一。Future Cities Institute / 滑铁卢大学主办的线上黑客松。'), date: L('Nov 2026', '2026 年 11 月'), href: 'https://devpost.com/software/exodus-czjiq5' },
  { name: 'CommuniHacks 2026', badge: L('Team member', '团队成员'), desc: L('24-hour hackathon in Waterloo. Team prototype SeedFlow for Youth in Food Systems; my pull request simplifying the review and packing workflows was merged. No award.', '在滑铁卢举行的 24 小时黑客松。团队原型 SeedFlow（为 Youth in Food Systems 开发）；我简化审核与打包流程的 pull request 已合并。未获奖。'), date: L('Nov 2026', '2026 年 11 月'), href: 'https://github.com/CommunihacksSeed/Seedtrack/pull/5' },
  { name: L('Euclid Mathematics Contest', 'Euclid 数学竞赛'), badge: '83/100', desc: L('University of Waterloo mathematics contest for Grade 12 students.', '滑铁卢大学面向 12 年级学生的数学竞赛。'), date: '2025', href: '' },
];
const recognition = [
  [L('Study Model Student', '学习标兵'), L('school award, high school', '学校评选，高中')],
  [L('University entrance scholarship offers', '大学入学奖学金 offer'), L('University of Alberta, McMaster (2025)', '阿尔伯塔大学、麦克马斯特大学（2025）')],
  ['IELTS Academic', L('overall band 7.0', '总分 7.0')],
  [L('Piano Level 10', '钢琴十级'), L('primary school', '小学')],
];
const sections = [
  { id: 'education', label: L('Education', '教育') },
  { id: 'experience', label: L('Experience', '经历') },
  { id: 'projects', label: L('Projects', '项目') },
  { id: 'open-source', label: L('Open source', '开源') },
  { id: 'research', label: L('Research & writing', '研究与写作') },
  { id: 'skills', label: L('Skills', '技能') },
  { id: 'awards', label: L('Honours', '荣誉') },
  { id: 'looking', label: L('Looking for', '在找什么') },
];
const profile = [
  [L('Program', '专业'), L('Honours Mathematics, Co-op', '数学荣誉学士，Co-op')],
  [L('School', '学校'), L('University of Waterloo · since Sep 2026', '滑铁卢大学 · 2026 年 9 月入学')],
  [L('Based in', '所在地'), L('Waterloo, Ontario', '加拿大安大略省滑铁卢')],
  [L('Languages', '语言'), L('Mandarin (native) · English (IELTS 7.0)', '中文（母语）· 英语（IELTS 7.0）')],
  [L('First co-op', '首个 Co-op'), L('May – Aug 2027', '2027 年 5–8 月')],
];
---
<BaseLayout lang={lang} path="/" title={t(lang, 'tagline').split('—')[1].trim()} description={h.lede}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">{h.kicker}</span>
          <h1>Ray Tian</h1>
          <p class="lede">{h.lede}</p>
          <p class="avail"><span class="dot" aria-hidden="true"></span><span>{h.seeking}</span></p>
          <div class="btns">
            <a class="btn primary" href="#projects">{h.ctaProjects}</a>
            <a class="btn" href="https://www.linkedin.com/in/dong-guo-604726444/">LinkedIn ↗</a>
            <a class="btn" href="https://github.com/Jelly-RayTian">GitHub ↗</a>
          </div>
        </div>
        <aside class="profile" aria-label={L('Profile', '简介')}>
          <h2>{L('At a glance', '一览')}</h2>
          <dl>{profile.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        </aside>
      </div>
      <div class="stats">{facts.map((f) => <div><b>{f.v}</b><span>{f.l}</span></div>)}</div>
    </div>
  </section>

  <div class="wrap resume">
    <nav class="index" aria-label={L('Sections', '本页内容')} data-spy>
      <p class="eyebrow">{L('On this page', '本页内容')}</p>
      <ol>{sections.map((x) => <li><a href={`#${x.id}`}>{x.label}</a></li>)}</ol>
    </nav>
    <div>
      <section class="sec" id="education">
        <div class="sec-h"><h2>{L('Education', '教育')}</h2><a class="arrow-link" href={route(lang, '/about/#education')}>{L('Details', '详情')} →</a></div>
        <div class="entries">
          <Entry when={uw.date} title={uw.org} role={uw.degree} sub={uw.place}
            desc={L('Coursework: CS 135 Designing Functional Programs · MATH 135 Algebra · MATH 137 Calculus 1 · ECON 101 Introductory Microeconomics', '课程：CS 135 函数式程序设计 · MATH 135 代数 · MATH 137 微积分 1 · ECON 101 微观经济学入门')} />
          <Entry when={hs.date} title={hs.org} role={hs.degree} sub={hs.place}
            desc={L('Average approximately 93.3% · Calculus 12 · Statistics 12 · Computer Science 12 · Physics 12 · Economics 12', '平均分约 93.3% · Calculus 12 · Statistics 12 · Computer Science 12 · Physics 12 · Economics 12')} />
        </div>
      </section>

      <section class="sec" id="experience">
        <div class="sec-h"><h2>{L('Experience', '经历')}</h2><a class="arrow-link" href={route(lang, '/experience/')}>{L('All experience', '全部经历')} →</a></div>
        <h3 class="sub-title">{L('Hackathons & competitions', '黑客松与竞赛')}</h3>
        <div class="entries">
          {competitions.map((c) => <Entry when={c.date} title={c.name} href={c.href || undefined} badge={c.badge} win={c.badge === L('Winner', '获奖')} desc={c.desc} />)}
        </div>
        <h3 class="sub-title">{L('Leadership & community', '领导力与社区')}</h3>
        <div class="entries">
          {leadership.map((e) => <Entry when={e.date} title={e.name} role={e.role} desc={e.text} />)}
        </div>
      </section>

      <section class="sec" id="projects">
        <div class="sec-h"><h2>{L('Selected projects', '重点项目')}</h2><a class="arrow-link" href={route(lang, '/projects/')}>{L('All projects', '全部项目')} →</a></div>
        <div class="entries">
          {projects.filter((p) => !p.name.startsWith('Exodus')).map((p) => <Entry when={p.date} title={p.name} href={p.href} sub={p.desc} bullets={p.bullets} />)}
        </div>
      </section>

      <section class="sec" id="open-source">
        <div class="sec-h"><h2>{L('Open-source contributions', '开源贡献')}</h2><a class="arrow-link" href={route(lang, '/open-source/')}>{L('Every pull request', '全部 PR')} →</a></div>
        <p class="sec-intro">{h.aiNote}</p>
        <div class="repos">
          {ossRepos.map((r) => { const st = repoStats(r); const o = ossDesc[r] ?? { name: r, d: '', b: '' }; return (
            <a class="repo" href={`https://github.com/${r}/pulls?q=author%3AJelly-RayTian`}>
              <div class="repo-top"><b>{o.name}</b><small>{st.total} PRs</small></div>
              {o.d && <em>{o.d}</em>}
              <div class="bar" aria-hidden="true">{bar(r).map((x) => <span class={`k-${x.k}`} style={`width:${x.w}%`}></span>)}</div>
              <small>{st.merged} {L('merged', '已合并')}{st.squashed + st.consolidated ? ` · ${st.squashed + st.consolidated} ${L('in main via maintainer', '经维护者进入 main')}` : ''} · {st.open} {L('open', '审核中')}</small>
              {o.b && <p>{o.b}</p>}
            </a>
          ); })}
        </div>
      </section>

      <section class="sec" id="research">
        <div class="sec-h"><h2>{L('Research & writing', '研究与写作')}</h2><a class="arrow-link" href={route(lang, '/systems/')}>{L('All writing', '全部写作')} →</a></div>
        <div class="entries">
          <Entry when={L('Nov 2026', '2026 年 11 月')} title="When Startup Failures Look the Same" href="https://doi.org/10.5281/zenodo.24096966"
            role={L('Technical report · Zenodo', '技术报告 · Zenodo')} sub={L('self-published, not peer-reviewed', '自行发布，未经同行评审')}
            desc={L('Examines missing and misleading startup diagnostics in Madeira through source inspection and reproducible log replay. Includes a targeted fix and its evaluation limits.', '通过源码分析和可复现的日志回放研究 Madeira 启动诊断中的遗漏与误报，包含针对性修正及其评估局限。')} />
          {content.writing.map((w) => <Entry when={w.date} title={w.title} href={w.url} role={w.venue} />)}
          {research.map((r) => <Entry when={r.date} title={r.title} role={r.role} bullets={r.bullets} />)}
        </div>
      </section>

      <section class="sec" id="skills">
        <div class="sec-h"><h2>{L('Skills', '技能')}</h2></div>
        <p class="sec-intro">{h.skillsP}</p>
        <dl class="skills">
          {content.skills.map((s) => <div><dt>{s.label[lang]}</dt><dd>{s.items[lang]}</dd></div>)}
          <div><dt>{t(lang, 'languagesLabel')}</dt><dd>{content.languages[lang]}</dd></div>
        </dl>
      </section>

      <section class="sec" id="awards">
        <div class="sec-h"><h2>{L('Honours & awards', '荣誉与奖项')}</h2><a class="arrow-link" href={route(lang, '/about/#honours')}>{L('Details', '详情')} →</a></div>
        <div class="honours">
          <div><b>CIVIC Hack 2026</b><span>{L('Winner · Best storytelling and visualizations', '获奖 · 最佳叙事与可视化')}</span></div>
          <div><b>{L('Euclid Mathematics Contest 2025', 'Euclid 数学竞赛 2025')}</b><span>83 / 100</span></div>
          {recognition.map(([a, b]) => <div><b>{a}</b><span>{b}</span></div>)}
        </div>
      </section>

      <section class="sec" id="looking">
        <div class="sec-h"><h2>{L('What I\'m looking for', '我在找什么')}</h2></div>
        <div class="callout">
          <p>{h.seeking}</p>
          <p style="margin-top:12px">{L('I\'m on Y Combinator\'s Co-Founder Matching platform, looking to join a founder with a concrete idea and build it together. I\'d cover product and engineering, and I\'m most interested in AI, developer tools, education, consumer and gaming. I\'m a student, so part-time during the term (about 10–15 hours a week, less during exam weeks, more during breaks), remote or Waterloo/Kitchener based — and I\'d like to start with a small trial project before committing.', '我在 Y Combinator 的 Co-Founder Matching 平台上，想加入一位有具体 idea 的创始人，一起把产品做出来。我负责产品与工程，感兴趣的方向是 AI、开发者工具、教育、消费与游戏。我是学生，学期期间兼职（每周约 10–15 小时，考试周会少，假期更多），远程或滑铁卢/Kitchener 本地，希望先从一个小的试做项目开始，合适再长期合作。')}</p>
          <div class="btns">
            <a class="btn primary" href="https://www.linkedin.com/in/dong-guo-604726444/">{L('Message me on LinkedIn', '在 LinkedIn 联系我')} ↗</a>
            <a class="btn" href="https://www.ycombinator.com/cofounder-matching">YC Co-Founder Matching ↗</a>
            <a class="btn" href={route(lang, '/about/#contact')}>{L('More ways to reach me', '更多联系方式')}</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
