---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { localePaths } from '../../lib/paths';
import { home } from '../../content/data/pages';
import { content, prs } from '../../lib/data';
import { route, t, type Lang } from '../../i18n/ui';
export const getStaticPaths = localePaths;
const { lang } = Astro.props as { lang: Lang };
const zh = lang === 'zh';
const h = home[lang];
const L = (en: string, cn: string) => (zh ? cn : en);
const systems = (await getCollection('systems')).filter((s) => s.data.lang === lang);
const pvz = systems.find((e) => e.data.pageSlug === 'pvz2-resource-analysis')!;
const uw = content.education[0][lang];
const merged = prs.filter((p) => p.status === 'merged').length;
const picks = [
  {
    title: 'WatDesk',
    meta: L('Edge extension · Oct 2026 – now', 'Edge 扩展 · 2026 年 10 月至今'),
    text: L('A side panel that puts Waterloo deadlines, exams and grades from LEARN, Crowdmark and Odyssey in one place. Data stays in your browser. Listed on Microsoft Edge Add-ons; 290 automated tests passed at v1.10.1.', '把 LEARN、Crowdmark 和 Odyssey 里的截止日期、考试和成绩放进同一个侧边栏。数据只留在浏览器里。已在 Microsoft Edge 加载项商店上架；v1.10.1 时 290 个自动化测试通过。'),
    href: route(lang, '/projects/watdesk/'),
    cta: L('See the project', '查看项目'),
  },
  {
    title: L('Open-source contributions', '开源贡献'),
    meta: 'PDFCraft · Madeira · job-ops',
    text: L(`Bug fixes sent to other people's projects, each with a way to reproduce the problem and tests. ${merged} pull requests merged so far.`, `给他人项目提交的 bug 修复，每个都有复现方法和测试。目前已合并 ${merged} 个 PR。`),
    href: route(lang, '/open-source/'),
    cta: L('See the fixes', '查看修复'),
  },
  {
    title: L('PvZ2 resource-file research', 'PvZ2 资源文件研究'),
    meta: L('Self-directed study · Nov 2026', '自主研究 · 2026 年 11 月'),
    text: L('How a mobile game stores its resource files, a small decoder I wrote to test my understanding, and an article on DEV Community and Zhihu.', '一款手游怎样存放资源文件，我为验证理解写的一个小解码器，以及发表在 DEV Community 和知乎的文章。'),
    href: route(lang, `/systems/${pvz.data.pageSlug}/`),
    cta: L('Read the write-up', '阅读全文'),
  },
];
const more = [
  [L('Education', '教育'), '/education/'], [L('Experience & leadership', '经历与领导力'), '/experience/'],
  [L('Skills', '技能'), '/about/'], [L('Technical writing', '技术写作'), '/systems/'], [L('Contact', '联系'), '/contact/'],
];
---
<BaseLayout lang={lang} path="/" title={t(lang, 'tagline').split('—')[1].trim()} description={h.lede}>
  <section class="hero">
    <div class="wrap">
      <div class="hero-main hero-solo">
        <div class="kicker">{h.kicker}</div>
        <h1><span>Ray</span> <em>Tian</em></h1>
        <p class="lede">{h.lede}</p>
        <p class="seeking">{h.seeking}</p>
        <div class="cta">
          <a class="btn gold" href="#projects">{h.ctaProjects} →</a>
          <a class="btn" href="https://www.linkedin.com/in/dong-guo-604726444/">LinkedIn</a>
          <a class="btn" href="https://github.com/Jelly-RayTian">GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <section class="block" id="projects">
    <div class="wrap">
      <div class="sh"><span class="kicker">{t(lang, 'featuredProjects')}</span><h2 class="page-h">{L('What I have built', '我做过的事')}</h2></div>
      <div class="picks">
        {picks.map((p) => (
          <a class="pick xcard" href={p.href}>
            <span class="kicker">{p.meta}</span>
            <b>{p.title}</b>
            <p>{p.text}</p>
            <span class="pick-cta">{p.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block" id="about">
    <div class="wrap">
      <div class="sh"><span class="kicker">{L('About', '关于')}</span><h2 class="page-h">{L('Education and background', '教育与背景')}</h2></div>
      <p class="about-line"><b>{uw.org}</b> — {uw.degree}, {uw.date}. {L('Euclid 2025: 83/100. Peer listening group founder, 3-year academic committee member, IELTS Academic 7.0.', 'Euclid 2025：83/100。同伴倾听小组发起人，三年学习委员，IELTS Academic 7.0。')}</p>
      <p class="more-row">{more.map(([label, path]) => <a class="btn" href={route(lang, path)}>{label}</a>)}</p>
    </div>
  </section>
</BaseLayout>
